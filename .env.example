# Ohbot Web GUI — API Keys Template
#
# Copy this file to .env and fill in your actual keys:
#   cp .env.example .env
#   nano .env
#
# NEVER commit your .env file to GitHub — it's already in .gitignore.

# Microsoft Azure Speech (text-to-speech + microphone input)
# Get yours at: https://portal.azure.com → Cognitive Services → Speech
AZURE_SPEECH_KEY=your_azure_speech_key_here
AZURE_SPEECH_REGION=eastus

# OpenAI (AI chat panel)
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here


# ── Optional settings ──────────────────────────────────────────────────────
# Leave these out entirely unless you need them.

# WINDOWS ONLY — how much silence to put in front of every clip, in
# milliseconds. Windows powers the sound device down when idle, and waking
# it up swallows the first fraction of a second of speech. A short run-up of
# silence gives it time to wake before the first word.
#   450 is the default, tested against HDMI audio (Aug 2026): the device
#   took ~300 ms to wake, 350 ms was borderline, 450 ms was clean.
#   Raise it if words are still being clipped; lower it if speech feels late.
#   0 turns it off. Ignored completely on the Pi and the Mac.
# AUDIO_LEAD_IN_MS=450

# Skip the COM port search and use this port directly (Windows).
# Find the right number with:  .\yobot.bat ports
# YOBOT_SERIAL_PORT=COM4

# LINUX/PI ONLY — force a specific ALSA microphone instead of auto-detecting.
# AZURE_MIC_DEVICE=plughw:2,0
