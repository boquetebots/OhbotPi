# Ohbot Web GUI — API Keys Template
#
# EASIEST WAY: don't edit this file at all. Start the robot, open the
# Launcher page in a browser (http://<the robot's address>:5000/) and use
# the "⚙️ Settings & Keys" link. It writes the keys here for you, tests
# them before you trust them, and restarts whatever needs restarting.
#
# By hand instead:
#   cp .env.example .env
#   nano .env
#
# NEVER commit your .env file to GitHub — it's already in .gitignore.

# Microsoft Azure Speech (text-to-speech + microphone input)
# Get yours at: https://portal.azure.com → Cognitive Services → Speech
AZURE_SPEECH_KEY=your_azure_speech_key_here
AZURE_SPEECH_REGION=eastus

# ── The AI that writes Yobot's replies ─────────────────────────────────────
# Leave all of this out and you get OpenAI, exactly as before.
#
# LLM_PROVIDER picks the company. They all understand the same kind of
# request, so switching is a different address and nothing else:
#     openai | anthropic | gemini | groq | ollama | custom
# LLM_MODEL and LLM_BASE_URL are optional — blank means "use that provider's
# usual one". You only really need LLM_BASE_URL for ollama and custom.
# LLM_PROVIDER=openai
# LLM_MODEL=
# LLM_BASE_URL=

# One key per company, so several can be set up at once and you can flip
# between them from the Settings page without re-pasting anything.
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=      # console.anthropic.com
# GEMINI_API_KEY=         # aistudio.google.com/apikey
# GROQ_API_KEY=           # console.groq.com
# OLLAMA_API_KEY=         # a local Ollama usually needs none
# LLM_API_KEY=            # for LLM_PROVIDER=custom


# ── Optional settings ──────────────────────────────────────────────────────
# Leave these out entirely unless you need them.

# WINDOWS ONLY — how much silence to put in front of every clip, in
# milliseconds. Windows powers the sound device down when idle, and waking
# it up swallows the first fraction of a second of speech. A short run-up of
# silence gives it time to wake before the first word.
#   450 is the default, tested against HDMI audio (Aug 2026): the device
#   took ~300 ms to wake, 350 ms was borderline, 450 ms was clean.
#   Raise it if words are still being clipped; lower it if speech feels late.
#   0 turns it off. Ignored completely on the Pi and the Mac.
# AUDIO_LEAD_IN_MS=450

# Skip the COM port search and use this port directly (Windows).
# Find the right number with:  .\yobot.bat ports
# YOBOT_SERIAL_PORT=COM4

# LINUX/PI ONLY — force a specific ALSA microphone instead of auto-detecting.
# AZURE_MIC_DEVICE=plughw:2,0

# The password for the Launcher's Settings page. Anybody on the same WiFi
# can open that page, so this stops them reading or replacing your keys.
# Set it from the page itself — it gets stored scrambled, not as plain text.
# Forgotten it? Delete this line, and the page will offer to make a new one.
# SETTINGS_PASSWORD=
